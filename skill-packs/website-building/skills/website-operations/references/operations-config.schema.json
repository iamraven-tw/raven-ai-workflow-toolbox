{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-workflow-toolbox/operations-config.schema.json",
  "title": "官網維運設定",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "public_url", "health", "backup", "updates"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["not_configured", "configured"] },
    "public_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https://"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timeout_seconds", "tls_warning_days", "history_limit", "checks"],
      "properties": {
        "enabled": { "type": "boolean" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "tls_warning_days": { "type": "integer", "minimum": 1, "maximum": 180 },
        "history_limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "expected_status", "required_text"],
            "properties": {
              "path": { "type": "string", "pattern": "^/(?!/)(?!.*[?#]).*$", "maxLength": 300 },
              "expected_status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "required_text": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 }
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_count", "stale_after_days", "workspace_paths", "project_paths"],
      "properties": {
        "retention_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "stale_after_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "workspace_paths": { "$ref": "#/$defs/relativePaths" },
        "project_paths": { "$ref": "#/$defs/relativePaths" }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_versions_only", "automatic_apply", "verified_backup_required", "local_build_required", "separate_deploy_authorization_required"],
      "properties": {
        "exact_versions_only": { "const": true },
        "automatic_apply": { "const": false },
        "verified_backup_required": { "const": true },
        "local_build_required": { "const": true },
        "separate_deploy_authorization_required": { "const": true }
      }
    }
  },
  "$defs": {
    "relativePaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[.][.])[^\\u005c]+$",
        "maxLength": 300
      }
    }
  }
}
