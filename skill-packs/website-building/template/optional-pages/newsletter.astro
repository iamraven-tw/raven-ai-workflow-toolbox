---
// 電子報：說明與 website-service-integration 的 hosted 訂閱入口。
import BaseLayout from '@theme/BaseLayout.astro';
import { site } from '../../site.config.mjs';
import ServiceIntegrations from '../components/ServiceIntegrations.astro';
---

<BaseLayout title="電子報" description={`訂閱 ${site.name} 的電子報`} canonical="/newsletter">
  <section class="t-container t-section">
    <div class="max-w-3xl">
      <p class="t-eyebrow">電子報</p>
      <h1 class="t-h1 mt-4" style="font-size: clamp(32px, 4vw, 52px);">電子報</h1>
      <p class="t-lead mt-6">說明電子報寫什麼、多久寄一次。這句是佔位文案。</p>
      <!-- website-service-integration:start -->
      <ServiceIntegrations only={['newsletter']} />
      <!-- website-service-integration:end -->
    </div>
  </section>
</BaseLayout>
