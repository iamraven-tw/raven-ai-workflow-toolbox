---
// 夜間工作室：面板色黏性導覽，小字 500、CTA 靛紫。
import { site } from '../../../site.config.mjs';
import { navLinks, ctaHref, ctaAttrs } from '../../lib/nav';
---

<header class="sticky top-0 z-50" style="background: rgba(15,16,17,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--ns-border-subtle);">
  <nav class="t-container flex h-16 items-center justify-between" aria-label="主要導覽">
    <a href="/" class="flex items-center gap-2 text-[15px] font-medium" style="color: var(--ns-text); text-decoration: none;">
      <span class="inline-block h-4 w-4 rounded-sm" style="background: var(--ns-brand);" aria-hidden="true"></span>{site.name}
    </a>
    <div class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-[13px] font-medium" style="color: var(--ns-text-2); text-decoration: none;">{link.label}</a>
      ))}
      <a href={ctaHref} class="t-btn" style="padding: 6px 12px; font-size: 13px;" {...ctaAttrs}>{site.cta.label}</a>
    </div>
    <button id="mobile-menu-button" class="flex h-9 w-9 items-center justify-center rounded-full md:hidden" style="background: rgba(255,255,255,0.03); border: 1px solid var(--ns-border); color: var(--ns-text);" aria-label="開啟選單" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden px-6 pb-5 md:hidden" style="background: var(--ns-panel); border-top: 1px solid var(--ns-border-subtle);" role="navigation" aria-label="行動版導覽">
    {navLinks.map((link) => (
      <a href={link.href} class="block py-3 text-[15px] font-medium" style="color: var(--ns-text-2); text-decoration: none;">{link.label}</a>
    ))}
    <a href={ctaHref} class="t-btn mt-3 w-full" {...ctaAttrs}>{site.cta.label}</a>
  </div>
</header>
<script src="../../lib/menu.ts"></script>
