---
// 夜間工作室文章頁：置中窄欄，目錄在右側面板。
import BaseLayout from './BaseLayout.astro';
interface TocItem { depth: number; slug: string; text: string; }
interface Props { title: string; date: string; description: string; slug: string; coverImage?: string; tags?: string[]; toc?: TocItem[]; }
const { title, date, description, slug, coverImage, tags, toc = [] } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={coverImage ?? '/og-image.png'} canonical={`/blog/${slug}/`}>
  <article class="t-container" style="padding-block: 96px;">
    <header class="mx-auto max-w-3xl">
      <div class="flex flex-wrap items-center gap-3 text-[13px]" style="font-family: var(--ns-mono); color: var(--ns-text-4);">
        <time datetime={date}>{date}</time>
        {tags && tags.map((tag) => <span class="t-tag" style="font-family: var(--ns-sans);">{tag}</span>)}
      </div>
      <h1 class="t-h1 mt-6" style="font-size: clamp(32px, 4vw, 48px);">{title}</h1>
      <p class="t-lead mt-5">{description}</p>
    </header>
    {coverImage && <img src={coverImage} alt={title} class="t-media mx-auto mt-12 w-full max-w-5xl" />}
    <div class="mx-auto mt-14 grid max-w-5xl gap-12 lg:grid-cols-[minmax(0,1fr)_240px]">
      <div class="t-prose prose prose-invert mx-auto w-full max-w-3xl"><slot /></div>
      {toc.length > 0 && (
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="t-card" style="padding: 20px;">
            <p class="t-eyebrow">目錄</p>
            <ul class="mt-4 space-y-2">
              {toc.map((item) => <li class={item.depth === 3 ? 'pl-3' : ''}><a href={`#${item.slug}`} class="text-[14px] font-medium" style="color: var(--ns-text-2); text-decoration: none;">{item.text}</a></li>)}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
