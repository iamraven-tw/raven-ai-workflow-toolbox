---
// 夜間工作室文章列表：像更新日誌的時間軸，左邊日期、右邊內容，半透明分隔。
interface Post { slug: string; title: string; date: string; description: string; tags?: string[]; coverImage?: string; }
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---

<section class="t-container" style="padding-block: 96px;">
  <p class="t-eyebrow">Changelog</p>
  <h1 class="t-h1 mt-4" style="font-size: clamp(36px, 5vw, 56px);">文章</h1>
  <p class="t-lead mt-5 max-w-2xl">記錄工作方法、案例與想法。這句是佔位文案，請依實際情況改寫。</p>
  <div class="mt-14 divide-y" style="border-color: var(--ns-border-subtle);">
    {posts.map((post) => (
      <article class="grid gap-3 py-8 md:grid-cols-[160px_minmax(0,1fr)]" style="border-color: var(--ns-border-subtle);">
        <time datetime={post.date} class="text-[13px] font-medium" style="font-family: var(--ns-mono); color: var(--ns-text-4);">{post.date}</time>
        <div>
          <a href={`/blog/${post.slug}/`} class="t-h3 block" style="text-decoration: none;">{post.title}</a>
          <p class="t-muted mt-2 text-[15px]">{post.description}</p>
          {post.tags && post.tags.length > 0 && <div class="mt-4 flex flex-wrap gap-2">{post.tags.map((tag) => <span class="t-tag">{tag}</span>)}</div>}
        </div>
      </article>
    ))}
  </div>
  {posts.length === 0 && <p class="t-muted mt-10">還沒有文章。</p>}
</section>
