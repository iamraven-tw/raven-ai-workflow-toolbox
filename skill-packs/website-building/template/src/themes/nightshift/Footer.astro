---
// 夜間工作室：極簡頁尾，小字、半透明分隔線。
import { site } from '../../../site.config.mjs';
import { footerLinks } from '../../lib/nav';
const year = new Date().getFullYear();
---

<footer style="border-top: 1px solid var(--ns-border-subtle);">
  <div class="t-container flex flex-col gap-4 py-10 text-[13px] md:flex-row md:items-center md:justify-between" style="color: var(--ns-text-4);">
    <p>© {year} {site.name}</p>
    <nav class="flex flex-wrap gap-5" aria-label="頁尾導覽">
      {footerLinks.map((link) => (
        <a href={link.href} class="font-medium" style="color: var(--ns-text-3); text-decoration: none;">{link.label}</a>
      ))}
    </nav>
  </div>
</footer>
