---
// 遊樂場文章頁：巨標、輕字重內文、目錄用藥丸標籤橫排。
import BaseLayout from './BaseLayout.astro';
interface TocItem { depth: number; slug: string; text: string; }
interface Props { title: string; date: string; description: string; slug: string; coverImage?: string; tags?: string[]; toc?: TocItem[]; }
const { title, date, description, slug, coverImage, tags, toc = [] } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={coverImage ?? '/og-image.png'} canonical={`/blog/${slug}/`}>
  <article class="t-container" style="padding-block: 104px;">
    <header class="max-w-4xl">
      <div class="flex flex-wrap items-center gap-3">
        <time datetime={date} class="t-eyebrow">{date}</time>
        {tags && tags.map((tag) => <span class="t-tag">{tag}</span>)}
      </div>
      <h1 class="t-h1 mt-6" style="font-size: clamp(36px, 5vw, 64px);">{title}</h1>
      <p class="t-lead mt-6">{description}</p>
    </header>
    {coverImage && <img src={coverImage} alt={title} class="t-media mt-12 w-full max-w-5xl" />}
    {toc.length > 0 && (
      <nav class="mt-12 flex flex-wrap gap-2" aria-label="文章目錄">
        {toc.map((item) => <a href={`#${item.slug}`} class="t-btn-secondary" style="font-size: 14px; padding: 6px 14px 7px;">{item.text}</a>)}
      </nav>
    )}
    <div class="t-prose prose prose-lg mt-12 w-full max-w-3xl"><slot /></div>
  </article>
</BaseLayout>
