---
// 遊樂場：白底導覽、黑字底線連結、藥丸 CTA、圓形選單按鈕。
import { site } from '../../../site.config.mjs';
import { navLinks, ctaHref, ctaAttrs } from '../../lib/nav';
---

<header class="sticky top-0 z-50 bg-white">
  <nav class="t-container flex h-[72px] items-center justify-between" aria-label="主要導覽">
    <a href="/" class="flex items-center gap-2 text-[18px] font-medium" style="color: #000; text-decoration: none; letter-spacing: -0.01em;">
      <span class="grid h-6 w-6 grid-cols-2 gap-[2px]" aria-hidden="true"><i class="rounded-full" style="background:#0acf83"></i><i class="rounded-full" style="background:#ffd400"></i><i class="rounded-full" style="background:#a259ff"></i><i class="rounded-full" style="background:#ff4fa3"></i></span>
      {site.name}
    </a>
    <div class="hidden items-center gap-7 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-[16px]" style="color: #000; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; font-weight: 400;">{link.label}</a>
      ))}
      <a href={ctaHref} class="t-btn" style="padding: 8px 18px 10px;" {...ctaAttrs}>{site.cta.label}</a>
    </div>
    <button id="mobile-menu-button" class="flex h-10 w-10 items-center justify-center rounded-full md:hidden" style="background: var(--pg-glass-dark); color: #000;" aria-label="開啟選單" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden bg-white px-6 pb-6 md:hidden" role="navigation" aria-label="行動版導覽">
    {navLinks.map((link) => (
      <a href={link.href} class="block py-3 text-[18px]" style="color: #000; text-decoration: underline; text-underline-offset: 4px;">{link.label}</a>
    ))}
    <a href={ctaHref} class="t-btn mt-4 w-full" {...ctaAttrs}>{site.cta.label}</a>
  </div>
</header>
<script src="../../lib/menu.ts"></script>
