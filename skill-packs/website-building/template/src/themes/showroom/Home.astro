---
// 黑白展場首頁：全幅照片開場，文字壓在照片下緣；之後每項服務是一個「章節」，
// 黑、白、淺灰交替，各配一張全寬照片與一句話；信任是黑底置中巨字；介面幾乎消失。
import { site } from '../../../site.config.mjs';
import { ctaHref, ctaAttrs } from '../../lib/nav';
const chapterImages = ['/images/samples/phone-edge.jpg', '/images/samples/vintage-camera.jpg', '/images/samples/dark-flatlay.jpg'];
const chapterTones = ['t-section-dark', '', 't-section-alt'];
---

<section class="relative overflow-hidden" style="background: #000; min-height: 88vh;">
  <img src="/images/samples/vintage-camera.jpg" alt="" width="1200" height="800" class="absolute inset-0 h-full w-full" style="object-fit: cover; filter: grayscale(1) brightness(0.55);" />
  <div class="relative flex min-h-[88vh] flex-col justify-end">
    <div class="t-container pb-16 md:pb-24" style="color: #f5f5f7;">
      <p class="t-eyebrow" style="color: #a1a1a6;">{site.name}</p>
      <h1 class="t-h1 mt-3 max-w-4xl" style="color: #f5f5f7;">{site.positioning}</h1>
      <p class="t-lead mt-5 max-w-2xl" style="color: #d2d2d7;">{site.audience}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        <a href={ctaHref} class="t-btn" {...ctaAttrs}>{site.cta.label}</a>
        <a href="/services" class="t-btn-secondary" style="color: #2997ff;">看服務內容</a>
      </div>
    </div>
  </div>
</section>

{site.offerings.map((offering, index) => (
  <section class={chapterTones[index % chapterTones.length]}>
    <div class="t-container flex flex-col items-center pt-24 text-center">
      <p class="t-eyebrow">{String(index + 1).padStart(2, '0')}</p>
      <h2 class="t-h2 mt-3 max-w-3xl">{offering.name}。</h2>
      <p class="t-lead mt-4 max-w-2xl">{offering.summary}</p>
      <a href="/services" class="t-btn-secondary mt-5">了解更多</a>
    </div>
    <div class="mx-auto mt-14 max-w-6xl px-6 pb-24">
      <img src={chapterImages[index % chapterImages.length]} alt="" width="1200" height="800" class="w-full rounded-[28px]" style={`aspect-ratio: 21 / 9; object-fit: cover; display: block; filter: ${index % 2 === 0 ? 'grayscale(1)' : 'saturate(0.85)'};`} />
    </div>
  </section>
))}

{site.trustSignals.length > 0 && (
  <section class="t-section-dark">
    <div class="t-container t-section">
      <p class="t-eyebrow text-center" style="color: #a1a1a6;">值得放心的理由</p>
      <div class="mx-auto mt-12 grid max-w-4xl gap-12 md:grid-cols-2">
        {site.trustSignals.map((signal) => (
          <p class="text-center text-[clamp(28px,3.5vw,44px)] font-semibold" style="font-family: var(--sr-display); line-height: 1.1; letter-spacing: -0.01em; color: #f5f5f7;">{signal}</p>
        ))}
      </div>
    </div>
  </section>
)}

<section class="t-section-alt">
  <div class="t-container t-section text-center">
    <h2 class="t-h2 mx-auto max-w-2xl">準備好開始了嗎？</h2>
    <p class="t-lead mx-auto mt-4 max-w-xl">一封信說明你的情況，我會告訴你值不值得做。</p>
    <a href={ctaHref} class="t-btn mt-8" {...ctaAttrs}>{site.cta.label}</a>
  </div>
</section>
