---
// 黑白展場：半透明深色細窄導覽列，小字、置中品牌。
import { site } from '../../../site.config.mjs';
import { navLinks, ctaHref, ctaAttrs } from '../../lib/nav';
---

<header class="sticky top-0 z-50" style="background: rgba(0,0,0,0.8); backdrop-filter: saturate(180%) blur(20px); color: #f5f5f7;">
  <nav class="t-container flex h-12 items-center justify-between" aria-label="主要導覽">
    <a href="/" class="text-[15px] font-semibold" style="color: #f5f5f7; text-decoration: none; letter-spacing: -0.01em;">{site.name}</a>
    <div class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-[12px]" style="color: rgba(245,245,247,0.8); text-decoration: none; letter-spacing: -0.01em;">{link.label}</a>
      ))}
      <a href={ctaHref} class="t-btn" style="padding: 4px 11px; font-size: 12px;" {...ctaAttrs}>{site.cta.label}</a>
    </div>
    <button id="mobile-menu-button" class="p-2 md:hidden" style="color: #f5f5f7;" aria-label="開啟選單" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8h16M4 16h16" /></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden px-6 pb-6 md:hidden" style="background: rgba(0,0,0,0.95);" role="navigation" aria-label="行動版導覽">
    {navLinks.map((link) => (
      <a href={link.href} class="block border-b py-4 text-[17px]" style="color: #f5f5f7; border-color: #272729; text-decoration: none;">{link.label}</a>
    ))}
    <a href={ctaHref} class="t-btn mt-5 w-full" {...ctaAttrs}>{site.cta.label}</a>
  </div>
</header>
<script src="../../lib/menu.ts"></script>
