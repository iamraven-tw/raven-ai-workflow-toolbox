---
// 黑白展場：淺灰頁尾、小字、細線分隔，像產品頁最底的法律資訊區。
import { site } from '../../../site.config.mjs';
import { footerLinks } from '../../lib/nav';
const year = new Date().getFullYear();
---

<footer class="t-section-alt">
  <div class="t-container py-10 text-[12px]" style="color: var(--sr-gray);">
    <nav class="flex flex-wrap gap-x-6 gap-y-2 border-b pb-4" style="border-color: var(--sr-border);" aria-label="頁尾導覽">
      {footerLinks.map((link) => (
        <a href={link.href} style="color: var(--sr-ink); text-decoration: none;">{link.label}</a>
      ))}
    </nav>
    <p class="pt-4">Copyright © {year} {site.name}. 保留所有權利。</p>
  </div>
</footer>
