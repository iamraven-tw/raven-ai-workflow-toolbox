---
// 報刊編輯首頁：真正的頭版。三欄報紙格：左欄頭條（眉標、巨大襯線標題、導言、署名），
// 中欄黑白照片加圖說，右欄「最多人讀」編號清單；下方黑色橫幅「服務」三欄故事格帶小照片；
// 結尾是 2px 黑框的訂閱式 CTA。
import { site } from '../../../site.config.mjs';
import { ctaHref, ctaAttrs } from '../../lib/nav';
const storyImages = ['/images/samples/keyboard-coffee.jpg', '/images/samples/laptop-coffee.jpg', '/images/samples/clean-desk.jpg'];
const today = new Date().toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section class="t-container t-section">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)_minmax(0,3fr)]">
    <article class="lg:border-r lg:pr-8" style="border-color: #000;">
      <p class="t-eyebrow">頭條 · {site.name}</p>
      <h1 class="t-h1 mt-3">{site.positioning}</h1>
      <p class="t-lead mt-5">{site.audience}</p>
      <p class="mt-4" style="font-family: var(--bs-mono); font-size: 12px; letter-spacing: 1.1px; text-transform: uppercase; color: #757575;">{site.name} 報導 · {today}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={ctaHref} class="t-btn" {...ctaAttrs}>{site.cta.label}</a>
        <a href="/services" class="t-btn-secondary">看服務內容</a>
      </div>
    </article>
    <figure class="lg:border-r lg:pr-8" style="border-color: #000;">
      <img src="/images/samples/keyboard-coffee.jpg" alt="" width="1200" height="800" class="t-media w-full" style="aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1) contrast(1.1);" />
      <figcaption class="mt-2" style="font-family: var(--bs-body); font-size: 12.7px; font-weight: 700; line-height: 2.2; color: #757575;">工作桌一角。攝影：範例圖庫。</figcaption>
      <p class="mt-4 t-eyebrow">本期重點</p>
      <p class="mt-2 t-h3">{site.offerings[0]?.name}</p>
      <p class="mt-2">{site.offerings[0]?.summary}</p>
    </figure>
    <aside>
      <span class="t-ribbon">最多人讀</span>
      <ol class="mt-2">
        {(site.trustSignals.length > 0 ? site.trustSignals : site.offerings.map((offering) => offering.name)).map((item, index) => (
          <li class="grid grid-cols-[48px_minmax(0,1fr)] items-baseline gap-3 border-b py-4" style="border-color: #000;">
            <span style="font-family: var(--bs-display); font-size: 40px; line-height: 1;">{String(index + 1).padStart(2, '0')}</span>
            <p class="t-h3" style="font-size: 17px;">{item}</p>
          </li>
        ))}
      </ol>
    </aside>
  </div>
</section>

<section class="t-container pb-12">
  <span class="t-ribbon">服務內容</span>
  <div class="t-grid-3 pt-6">
    {site.offerings.map((offering, index) => (
      <article class="t-card pb-8">
        <img src={storyImages[index % storyImages.length]} alt="" width="1200" height="800" class="t-media w-full" style="aspect-ratio: 16 / 9; object-fit: cover; filter: grayscale(1);" />
        <p class="t-eyebrow mt-4">{String(index + 1).padStart(2, '0')} · 服務</p>
        <h3 class="t-card-title mt-2">{offering.name}</h3>
        <p class="mt-3">{offering.summary}</p>
        <a href="/services" class="t-link mt-4 inline-block" style="font-family: var(--bs-ui); font-size: 14px; letter-spacing: 0.4px;">閱讀更多</a>
      </article>
    ))}
  </div>
</section>

<section class="t-container pb-16">
  <div class="grid items-center gap-6 border-2 p-8 md:grid-cols-[minmax(0,1fr)_auto] md:p-10" style="border-color: #000;">
    <div>
      <p class="t-eyebrow">直接聊，不必訂閱</p>
      <h2 class="t-h2 mt-2">準備好開始了嗎？</h2>
      <p class="mt-3">一封信說明你的情況，我會告訴你值不值得做。</p>
    </div>
    <a href={ctaHref} class="t-btn-secondary" {...ctaAttrs}>{site.cta.label}</a>
  </div>
</section>
