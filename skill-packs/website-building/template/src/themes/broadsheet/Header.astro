---
// 報刊編輯：上方黑色公用條（等寬大寫）、下方紙白主導覽、置中報頭式站名、2px 黑框 CTA。
import { site } from '../../../site.config.mjs';
import { navLinks, ctaHref, ctaAttrs } from '../../lib/nav';
const today = new Date().toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<header>
  <div style="background: #000; color: #fff;">
    <div class="t-container flex h-9 items-center justify-between" style="font-family: var(--bs-mono); font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase;">
      <span>{today}</span>
      <a href="/rss.xml" style="color: #fff; text-decoration: none;">RSS</a>
    </div>
  </div>
  <div class="t-container border-b-2 py-5" style="border-color: #000;">
    <div class="flex items-center justify-between md:grid md:grid-cols-3">
      <button id="mobile-menu-button" class="flex h-10 w-10 items-center justify-center rounded-full border md:hidden" style="border-color: #757575; color: #000;" aria-label="開啟選單" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="square" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
      <span class="hidden md:block"></span>
      <a href="/" class="text-center" style="font-family: var(--bs-display); font-size: clamp(28px, 4vw, 44px); font-weight: 700; letter-spacing: -0.5px; color: #000; text-decoration: none;">{site.name}</a>
      <div class="flex justify-end">
        <a href={ctaHref} class="t-btn" style="padding: 8px 16px; font-size: 14px;" {...ctaAttrs}>{site.cta.label}</a>
      </div>
    </div>
    <nav class="hidden justify-center gap-8 pt-4 md:flex" aria-label="主要導覽" style="font-family: var(--bs-ui); font-size: 14px; letter-spacing: 0.4px;">
      {navLinks.map((link) => (
        <a href={link.href} class="t-link" style="text-decoration: none;">{link.label}</a>
      ))}
    </nav>
  </div>
  <div id="mobile-menu" class="hidden border-b-2 px-6 py-4 md:hidden" style="border-color: #000;" role="navigation" aria-label="行動版導覽">
    {navLinks.map((link) => (
      <a href={link.href} class="block border-b py-3" style="font-family: var(--bs-mono); font-size: 13px; letter-spacing: 0.92px; text-transform: uppercase; color: #1a1a1a; border-color: #e2e8f0; text-decoration: none;">{link.label}</a>
    ))}
  </div>
</header>
<script src="../../lib/menu.ts"></script>
