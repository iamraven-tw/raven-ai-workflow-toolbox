---
// 報刊編輯：唯一的深色區域，#1a1a1a 底、紙白小字。
import { site } from '../../../site.config.mjs';
import { footerLinks } from '../../lib/nav';
const year = new Date().getFullYear();
---

<footer style="background: #1a1a1a; color: #fff;">
  <div class="t-container py-12">
    <p class="text-center" style="font-family: var(--bs-display); font-size: 32px; font-weight: 700; letter-spacing: -0.5px;">{site.name}</p>
    <nav class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="頁尾導覽" style="font-family: var(--bs-ui); font-size: 11px; letter-spacing: 0.4px;">
      {footerLinks.map((link) => (
        <a href={link.href} style="color: #fff; text-decoration: none;">{link.label}</a>
      ))}
    </nav>
    <p class="mt-8 text-center" style="font-family: var(--bs-mono); font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase; color: #999;">© {year} {site.name}</p>
  </div>
</footer>
