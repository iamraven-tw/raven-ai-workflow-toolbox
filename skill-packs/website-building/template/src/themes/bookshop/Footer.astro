---
// 紙本書店：近黑深色頁尾，像書的最後一頁。
import { site } from '../../../site.config.mjs';
import { footerLinks } from '../../lib/nav';
const year = new Date().getFullYear();
---

<footer class="t-section-dark">
  <div class="t-container flex flex-col gap-6 py-14 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-3xl" style="font-family: var(--bk-serif); font-weight: 500;">{site.name}</p>
      <p class="t-muted mt-2 max-w-md text-[15px]">{site.positioning}</p>
    </div>
    <nav class="flex flex-wrap gap-6 text-[15px]" aria-label="頁尾導覽">
      {footerLinks.map((link) => (
        <a href={link.href} style="color: var(--bk-silver); text-decoration: none;">{link.label}</a>
      ))}
    </nav>
  </div>
  <div class="t-container pb-8 text-[14px]" style="color: var(--bk-stone);">© {year} {site.name}</div>
</footer>
