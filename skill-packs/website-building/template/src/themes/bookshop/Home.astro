---
// 紙本書店首頁：像一篇長文。左邊巨大襯線標題與首字放大的導言，右邊直式照片加圖說；
// 服務排成「目錄」而不是卡片；深色章節放一句引言；結尾是咖啡桌照片橫幅。
import { site } from '../../../site.config.mjs';
import { ctaHref, ctaAttrs } from '../../lib/nav';
const [firstSignal, ...otherSignals] = site.trustSignals;
---

<section class="t-container" style="padding-block: 96px 80px;">
  <div class="grid items-start gap-16 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
    <div>
      <p class="t-eyebrow">第一章 · {site.name}</p>
      <h1 class="t-h1 mt-6">{site.positioning}</h1>
      <p class="mt-10 max-w-xl text-[20px] leading-[1.7]" style="color: var(--bk-olive);">
        <span class="float-left mr-3 mt-2 text-[56px] leading-[0.85]" style="font-family: var(--bk-serif); color: var(--bk-terracotta);">{site.audience.slice(0, 1)}</span>{site.audience.slice(1)}
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={ctaHref} class="t-btn" {...ctaAttrs}>{site.cta.label}</a>
        <a href="/services" class="t-btn-secondary">翻到服務那一章</a>
      </div>
    </div>
    <figure class="lg:pl-6">
      <img src="/images/samples/writing-hand.jpg" alt="" width="900" height="1200" class="t-media w-full" style="aspect-ratio: 3 / 4; object-fit: cover; filter: sepia(0.18) saturate(0.9);" />
      <figcaption class="mt-3 text-[14px]" style="color: var(--bk-stone);">先寫下來，再決定要不要交給機器。</figcaption>
    </figure>
  </div>
</section>

<section class="t-section-alt">
  <div class="t-container" style="padding-block: 80px;">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
      <div>
        <p class="t-eyebrow">目錄</p>
        <h2 class="t-h2 mt-4">三章，各解決一件事</h2>
        <img src="/images/samples/open-book.jpg" alt="" width="1200" height="800" class="t-media mt-10 hidden w-full lg:block" style="aspect-ratio: 4 / 3; object-fit: cover;" />
      </div>
      <ol class="divide-y" style="border-color: var(--bk-border-warm);">
        {site.offerings.map((offering, index) => (
          <li class="grid gap-4 py-8 first:pt-0 md:grid-cols-[96px_minmax(0,1fr)]" style="border-color: var(--bk-border-warm);">
            <span class="text-[40px] leading-none" style="font-family: var(--bk-serif); color: var(--bk-terracotta);">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="t-h3">{offering.name}</h3>
              <p class="mt-3 text-[17px] leading-[1.6]" style="color: var(--bk-olive);">{offering.summary}</p>
              <a href="/services" class="t-link mt-3 inline-block text-[15px]">閱讀這一章 →</a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

{firstSignal && (
  <section class="t-section-dark">
    <div class="t-container" style="padding-block: 96px;">
      <p class="t-eyebrow" style="color: var(--bk-silver);">引言</p>
      <blockquote class="mt-6 max-w-4xl text-[clamp(28px,3.6vw,48px)] leading-[1.25]" style="font-family: var(--bk-serif); font-weight: 500;">「{firstSignal}。」</blockquote>
      {otherSignals.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-x-10 gap-y-3 text-[17px]" style="color: var(--bk-silver);">
          {otherSignals.map((signal) => <li>{signal}</li>)}
        </ul>
      )}
    </div>
  </section>
)}

<section class="t-container" style="padding-block: 96px;">
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <img src="/images/samples/cafe-table.jpg" alt="" width="1200" height="800" class="t-media w-full" style="aspect-ratio: 3 / 2; object-fit: cover; filter: sepia(0.15);" />
    <div>
      <p class="t-eyebrow">最後一章</p>
      <h2 class="t-h2 mt-4">先聊三十分鐘，再決定要不要做</h2>
      <p class="t-lead mt-6">一封信說明你的情況，我會告訴你值不值得做，以及從哪裡開始最省力。</p>
      <a href={ctaHref} class="t-btn mt-8" {...ctaAttrs}>{site.cta.label}</a>
    </div>
  </div>
</section>
