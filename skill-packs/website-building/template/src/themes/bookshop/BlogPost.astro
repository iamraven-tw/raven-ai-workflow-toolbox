---
// 紙本書店文章頁：窄欄、襯線標題、目錄在右側像頁緣註記。
import BaseLayout from './BaseLayout.astro';
interface TocItem { depth: number; slug: string; text: string; }
interface Props { title: string; date: string; description: string; slug: string; coverImage?: string; tags?: string[]; toc?: TocItem[]; }
const { title, date, description, slug, coverImage, tags, toc = [] } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={coverImage ?? '/og-image.png'} canonical={`/blog/${slug}/`}>
  <article class="t-container" style="padding-block: 96px;">
    <header class="mx-auto max-w-3xl">
      <p class="t-eyebrow">文章</p>
      <h1 class="t-h1 mt-4" style="font-size: clamp(32px, 4vw, 52px);">{title}</h1>
      <p class="t-lead mt-5">{description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3 text-[14px]" style="color: var(--bk-stone);">
        <time datetime={date}>{date}</time>
        {tags && tags.map((tag) => <span class="t-tag">{tag}</span>)}
      </div>
    </header>
    {coverImage && <img src={coverImage} alt={title} class="t-media mx-auto mt-12 w-full max-w-5xl" />}
    <div class="mx-auto mt-14 grid max-w-5xl gap-12 lg:grid-cols-[minmax(0,1fr)_240px]">
      <div class="t-prose prose prose-lg mx-auto w-full max-w-3xl"><slot /></div>
      {toc.length > 0 && (
        <aside class="lg:sticky lg:top-28 lg:self-start">
          <p class="t-eyebrow">本文目錄</p>
          <ul class="mt-4 space-y-3 border-l pl-4" style="border-color: var(--bk-border-warm);">
            {toc.map((item) => <li class={item.depth === 3 ? 'pl-3' : ''}><a href={`#${item.slug}`} class="text-[15px]" style="color: var(--bk-olive); text-decoration: none;">{item.text}</a></li>)}
          </ul>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
