---
// 紙本書店文章列表：像書的目錄，一列一篇、襯線標題、細線分隔，不是卡片網格。
interface Post { slug: string; title: string; date: string; description: string; tags?: string[]; coverImage?: string; }
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---

<section class="t-container" style="padding-block: 96px;">
  <p class="t-eyebrow">文章</p>
  <h1 class="t-h1 mt-4">目錄</h1>
  <p class="t-lead mt-5 max-w-2xl">記錄工作方法、案例與想法。這句是佔位文案，請依實際情況改寫。</p>
  <ol class="mt-14 divide-y" style="border-color: var(--bk-border-warm);">
    {posts.map((post, index) => (
      <li class="grid gap-3 py-8 md:grid-cols-[80px_minmax(0,1fr)_160px] md:items-baseline" style="border-color: var(--bk-border-warm);">
        <span class="text-[25.6px]" style="font-family: var(--bk-serif); color: var(--bk-stone);">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <a href={`/blog/${post.slug}/`} class="t-h3 block" style="color: var(--bk-ink); text-decoration: none;">{post.title}</a>
          <p class="t-muted mt-2">{post.description}</p>
          {post.tags && post.tags.length > 0 && <div class="mt-3 flex flex-wrap gap-2">{post.tags.map((tag) => <span class="t-tag">{tag}</span>)}</div>}
        </div>
        <time datetime={post.date} class="text-[14px] md:text-right" style="color: var(--bk-stone);">{post.date}</time>
      </li>
    ))}
  </ol>
  {posts.length === 0 && <p class="t-muted mt-10">還沒有文章。</p>}
</section>
