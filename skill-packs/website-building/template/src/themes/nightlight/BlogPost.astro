---
// 小夜燈文章頁：標題置中，封面放進視窗框，內文窄欄，目錄在右側。
import BaseLayout from './BaseLayout.astro';
interface TocItem { depth: number; slug: string; text: string; }
interface Props { title: string; date: string; description: string; slug: string; coverImage?: string; tags?: string[]; toc?: TocItem[]; }
const { title, date, description, slug, coverImage, tags, toc = [] } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={coverImage ?? '/og-image.png'} canonical={`/blog/${slug}/`}>
  <article class="t-container t-section">
    <header class="mx-auto max-w-3xl text-center">
      <div class="flex flex-wrap items-center justify-center gap-3" data-reveal="fade">
        <time datetime={date} class="text-[13px]" style="color: var(--nl-muted);">{date}</time>
        {tags && tags.map((tag) => <span class="t-tag">{tag}</span>)}
      </div>
      <h1 class="t-h1 mt-6" style="font-size: clamp(32px, 4.4vw, 60px);" data-reveal="up">{title}</h1>
      <p class="t-lead mt-5" data-reveal="up" data-reveal-delay="100">{description}</p>
    </header>
    {coverImage && (
      <div class="nl-window mx-auto mt-12 max-w-4xl" data-reveal="scale">
        <div class="nl-window__bar" aria-hidden="true"><span class="nl-dots"><i></i><i></i><i></i></span></div>
        <div class="overflow-hidden rounded-[14px]"><img src={coverImage} alt={title} class="w-full object-cover" style="aspect-ratio: 16 / 9;" /></div>
      </div>
    )}
    <div class="mx-auto mt-14 grid max-w-5xl gap-12 lg:grid-cols-[minmax(0,1fr)_240px]">
      <div class="t-prose prose prose-invert prose-lg mx-auto w-full max-w-3xl"><slot /></div>
      {toc.length > 0 && (
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="nl-bubble">
            <p class="t-eyebrow">目錄</p>
            <ul class="mt-4 space-y-2">
              {toc.map((item) => <li class={item.depth === 3 ? 'pl-3' : ''}><a href={`#${item.slug}`} class="text-[14px] font-medium" style="color: var(--nl-fg); text-decoration: none;">{item.text}</a></li>)}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
