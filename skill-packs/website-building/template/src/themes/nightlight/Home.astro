---
// 小夜燈首頁：打招呼式首屏（左兩行大字、右瀏覽器視窗框放照片與貼紙）→ 關於我一句話加信任依據 → 最近寫的做成一疊視窗卡
// → 四色服務卡 → 結尾大字中間嵌一張圓形照片。
import { getCollection } from 'astro:content';
import { site } from '../../../site.config.mjs';
import { copy } from '../../../site.copy.mjs';
import { ctaHref, ctaAttrs } from '../../lib/nav';

const posts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);
const fallbackCovers = ['/images/samples/creative-desk.jpg', '/images/samples/raspberries.jpg', '/images/samples/phone-edge.jpg', '/images/samples/vintage-camera.jpg'];
const coverTints = ['#7772ff', '#ff9e9e', '#f5c451', '#d4f06d'];
const title = copy.home.title ?? site.positioning;
// 打招呼式標題：有逗號就在逗號後換行並把後半句上色；沒有就整句白色。
const comma = title.search(/[，,、]/);
const titleHead = comma > 0 ? title.slice(0, comma + 1) : title;
const titleTail = comma > 0 ? title.slice(comma + 1) : '';
const closing = copy.home.closing_heading ?? '一起做點有意思的事';
const closingHalf = Math.ceil(closing.length / 2);
const stickers = site.offerings.slice(0, 2).map((offering) => offering.name.slice(0, 4));
const accents = ['var(--nl-purple)', 'var(--nl-lime)', 'var(--nl-pink)', 'var(--nl-yellow)'];
const pad = (index: number) => String(index + 1).padStart(2, '0');
const year = new Date().getFullYear();
---

<section class="nl-hero -mt-[76px] pt-[76px]">
  <div class="t-container grid items-center gap-14 py-16 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:py-28">
    <div>
      <p class="nl-pin" data-reveal="fade">{copy.home.eyebrow ?? site.name}</p>
      <h1 class="t-h1 mt-6" data-reveal="up" data-reveal-delay="80">{titleHead}{titleTail && <><br /><span class="nl-accent">{titleTail}</span></>}</h1>
      <p class="t-lead mt-6 max-w-md" data-reveal="up" data-reveal-delay="180">{copy.home.lead ?? site.audience}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal="up" data-reveal-delay="280">
        <a href={ctaHref} class="t-btn" {...ctaAttrs}>{copy.home.primary_cta ?? site.cta.label}</a>
        {site.contacts.map((channel) => <a href={channel.target} class="t-btn-secondary" {...(channel.kind === 'email' ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>{channel.label}</a>)}
      </div>
    </div>
    <div class="relative mx-auto w-full max-w-[460px] lg:justify-self-end" data-reveal="scale" data-reveal-delay="160">
      <div class="nl-window">
        <div class="nl-window__bar" aria-hidden="true"><span class="nl-dots"><i></i><i></i><i></i></span><span class="nl-window__glyphs"><i></i><i></i><i></i></span></div>
        <div class="nl-window__panel">
          <img src="/images/samples/portrait.jpg" alt="" width="900" height="1200" fetchpriority="high" data-parallax="-0.05" style="scale: 1.1;" />
        </div>
        {stickers[0] && <span class="nl-sticker nl-sticker--a" aria-hidden="true">{stickers[0]}</span>}
        {stickers[1] && <span class="nl-sticker nl-sticker--b" aria-hidden="true">{stickers[1]}</span>}
        <span class="nl-star" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<section class="t-container t-section">
  <div class="grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)]">
    <p class="t-eyebrow self-start" data-reveal="fade">{copy.about.title ?? '關於我'}</p>
    <div>
      <p class="nl-statement" data-reveal="up">{copy.about.intro ?? copy.home.offerings_intro ?? '我做的事很簡單：把重複的工作交給流程，把時間留給人。'}<i aria-hidden="true" style="color: var(--nl-lime);">✦</i></p>
      {site.trustSignals.length > 0 && (
        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger="120">
          {site.trustSignals.map((signal, index) => (
            <div>
              <p class="nl-stat" style={`color: ${accents[index % accents.length]};`}>{pad(index)}</p>
              <p class="mt-3 text-[15px] leading-7" style="color: var(--nl-muted);">{signal}</p>
            </div>
          ))}
        </div>
      )}
      <a href="/about" class="t-btn mt-12" data-reveal="fade">{copy.about.cta_heading ?? '更多關於我'}</a>
    </div>
  </div>
</section>

{posts.length > 0 && (
  <section class="t-container t-section" style="padding-top: 0;">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <h2 class="t-h2" data-reveal="up">{copy.blog.title ?? '最近'}<br /><span class="nl-accent">寫的</span></h2>
        <p class="mt-4 text-[14px] font-medium" style="color: var(--nl-lime);" data-reveal="fade">({year}©)</p>
        <a href="/blog" class="t-btn mt-8" data-reveal="fade">全部文章</a>
      </div>
      <div class="space-y-6" data-reveal-stagger="140">
        {posts.map((post, index) => (
          <a href={`/blog/${post.id}/`} class="nl-work">
            <div class="nl-window__bar" aria-hidden="true"><span class="nl-dots"><i></i><i></i><i></i></span></div>
            <div class="nl-work__media" style={`background: ${coverTints[index % coverTints.length]};`}>
              <img src={post.data.coverImage ?? fallbackCovers[index % fallbackCovers.length]} alt="" width="1200" height="900" loading="lazy" />
              <span class="nl-work__tag t-tag">{post.data.tags?.[0] ?? post.data.date}</span>
              <span class="nl-work__arrow" aria-hidden="true">↗</span>
            </div>
            <div class="px-3 pb-3 pt-5">
              <h3 class="t-card-title">{post.data.title}</h3>
              <p class="t-muted mt-2 text-[15px] leading-7">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="t-container t-section" style="padding-top: 0;">
  <h2 class="t-h2" data-reveal="up">{copy.home.offerings_heading ?? '我能幫上的'}<span class="nl-accent"> 三件事</span></h2>
  {copy.home.offerings_intro && <p class="t-lead mt-4 max-w-xl" data-reveal="up" data-reveal-delay="100">{copy.home.offerings_intro}</p>}
  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger="120" data-reveal-variant="scale">
    {site.offerings.map((offering, index) => (
      <article class="nl-service">
        <span class="nl-service__icon" aria-hidden="true">{pad(index)}</span>
        <h3>{offering.name}</h3>
        <p>{offering.summary}</p>
      </article>
    ))}
  </div>
</section>

<section class="t-container t-section text-center">
  <p class="t-eyebrow justify-center" data-reveal="fade">{copy.home.closing_eyebrow ?? '有想做的事嗎？'}</p>
  <h2 class="nl-giant mx-auto mt-8 max-w-4xl" data-reveal="up">{closing.slice(0, closingHalf)}<img src="/images/samples/portrait.jpg" alt="" width="900" height="1200" loading="lazy" />{closing.slice(closingHalf)}</h2>
  <p class="t-lead mx-auto mt-6 max-w-xl" data-reveal="up" data-reveal-delay="120">{copy.home.closing_lead ?? '一封信說明你的情況，我會告訴你值不值得做。'}</p>
  <a href={ctaHref} class="t-btn mt-10" data-reveal="up" data-reveal-delay="200" {...ctaAttrs}>{copy.home.primary_cta ?? site.cta.label}</a>
</section>
