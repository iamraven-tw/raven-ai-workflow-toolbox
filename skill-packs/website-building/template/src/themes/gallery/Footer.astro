---
// 留白畫廊：白底頁尾、上方一條黑線、等寬小字。
import { site } from '../../../site.config.mjs';
import { footerLinks } from '../../lib/nav';
const year = new Date().getFullYear();
---

<footer class="t-rule">
  <div class="t-container grid gap-8 py-14 md:grid-cols-[minmax(0,1fr)_auto]">
    <div>
      <p class="text-[20px] font-semibold" style="letter-spacing: -0.03em;">{site.name}</p>
      <p class="t-eyebrow mt-3">© {year}</p>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-3 text-[14px] font-medium" aria-label="頁尾導覽">
      {footerLinks.map((link) => (
        <a href={link.href} style="color: var(--gl-gray-600); text-decoration: none;">{link.label}</a>
      ))}
    </nav>
  </div>
</footer>
