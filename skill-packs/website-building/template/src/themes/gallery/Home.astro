---
// 留白畫廊首頁：只有文字與留白。巨大緊縮標題；一張單色照片帶 1px 環框；
// 三項服務用垂直細線分成三欄；一句超大細字重的聲明；信任是兩個大數字式卡片。
import { site } from '../../../site.config.mjs';
import { ctaHref, ctaAttrs } from '../../lib/nav';
---

<section class="t-container" style="padding-block: 160px 96px;">
  <h1 class="t-h1 max-w-5xl">{site.positioning}</h1>
  <div class="mt-12 flex flex-col gap-3 sm:flex-row">
    <a href={ctaHref} class="t-btn" {...ctaAttrs}>{site.cta.label}</a>
    <a href="/services" class="t-btn-secondary">服務內容</a>
  </div>
</section>

<section class="t-container pb-28">
  <img src="/images/samples/mono-desk.jpg" alt="" width="1200" height="800" class="t-media w-full" style="aspect-ratio: 21 / 9; object-fit: cover; filter: grayscale(1) contrast(1.05);" />
</section>

<section class="t-rule">
  <div class="t-container t-section">
    <div class="grid divide-y md:grid-cols-3 md:divide-x md:divide-y-0" style="border-color: var(--gl-gray-100);">
      {site.offerings.map((offering, index) => (
        <div class="py-8 md:px-10 md:py-0 md:first:pl-0 md:last:pr-0" style="border-color: var(--gl-gray-100);">
          <p class="t-eyebrow">{String(index + 1).padStart(2, '0')}</p>
          <h2 class="t-card-title mt-6">{offering.name}</h2>
          <p class="t-muted mt-4 text-[16px]">{offering.summary}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="t-rule">
  <div class="t-container t-section">
    <p class="max-w-5xl text-[clamp(28px,4vw,56px)] leading-[1.15]" style="font-weight: 300; letter-spacing: -0.03em; color: var(--gl-ink);">{site.audience}</p>
  </div>
</section>

{site.trustSignals.length > 0 && (
  <section class="t-rule">
    <div class="t-container t-section grid gap-6 md:grid-cols-2">
      {site.trustSignals.map((signal, index) => (
        <div class="t-card flex min-h-[220px] flex-col justify-between">
          <p class="t-eyebrow">{String(index + 1).padStart(2, '0')} / {String(site.trustSignals.length).padStart(2, '0')}</p>
          <p class="text-[32px] font-semibold leading-[1.15]" style="letter-spacing: -0.045em;">{signal}</p>
        </div>
      ))}
    </div>
  </section>
)}

<section class="t-rule">
  <div class="t-container t-section flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <h2 class="t-h2 max-w-xl">準備好開始了嗎？</h2>
    <a href={ctaHref} class="t-btn" {...ctaAttrs}>{site.cta.label}</a>
  </div>
</section>
