---
// 留白畫廊文章列表：白色卡片網格，陰影堆疊當邊框，等寬日期。
interface Post { slug: string; title: string; date: string; description: string; tags?: string[]; coverImage?: string; }
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---

<section class="t-container" style="padding-block: 112px;">
  <p class="t-eyebrow">Blog</p>
  <h1 class="t-h1 mt-4" style="font-size: clamp(36px, 5vw, 56px);">文章</h1>
  <p class="t-lead mt-5 max-w-2xl">記錄工作方法、案例與想法。這句是佔位文案，請依實際情況改寫。</p>
  <div class="t-grid-2 mt-14">
    {posts.map((post) => (
      <article class="t-card flex flex-col">
        {post.coverImage && <img src={post.coverImage} alt="" width="1200" height="800" class="t-media mb-6 w-full" style="aspect-ratio: 16 / 9; object-fit: cover; filter: grayscale(1);" />}
        <time datetime={post.date} class="t-eyebrow">{post.date}</time>
        <a href={`/blog/${post.slug}/`} class="t-card-title mt-4 block" style="text-decoration: none;">{post.title}</a>
        <p class="t-muted mt-3 flex-1">{post.description}</p>
        {post.tags && post.tags.length > 0 && <div class="mt-5 flex flex-wrap gap-2">{post.tags.map((tag) => <span class="t-tag">{tag}</span>)}</div>}
      </article>
    ))}
  </div>
  {posts.length === 0 && <p class="t-muted mt-10">還沒有文章。</p>}
</section>
