---
// 留白畫廊文章頁：置中窄欄、標題上方一條黑線、目錄在左側像畫廊標籤。
import BaseLayout from './BaseLayout.astro';
interface TocItem { depth: number; slug: string; text: string; }
interface Props { title: string; date: string; description: string; slug: string; coverImage?: string; tags?: string[]; toc?: TocItem[]; }
const { title, date, description, slug, coverImage, tags, toc = [] } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={coverImage ?? '/og-image.png'} canonical={`/blog/${slug}/`}>
  <article class="t-container" style="padding-block: 112px;">
    <header class="mx-auto max-w-3xl border-t pt-8" style="border-color: var(--gl-ink);">
      <div class="flex flex-wrap items-center gap-3">
        <time datetime={date} class="t-eyebrow">{date}</time>
        {tags && tags.map((tag) => <span class="t-tag">{tag}</span>)}
      </div>
      <h1 class="t-h1 mt-6" style="font-size: clamp(32px, 4vw, 48px);">{title}</h1>
      <p class="t-lead mt-5">{description}</p>
    </header>
    {coverImage && <img src={coverImage} alt={title} class="t-media mx-auto mt-12 w-full max-w-5xl" />}
    <div class="mx-auto mt-14 grid max-w-5xl gap-12 lg:grid-cols-[200px_minmax(0,1fr)]">
      {toc.length > 0 ? (
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <p class="t-eyebrow">On this page</p>
          <ul class="mt-4 space-y-2">
            {toc.map((item) => <li class={item.depth === 3 ? 'pl-3' : ''}><a href={`#${item.slug}`} class="text-[14px] font-medium" style="color: var(--gl-gray-600); text-decoration: none;">{item.text}</a></li>)}
          </ul>
        </aside>
      ) : <div></div>}
      <div class="t-prose prose prose-lg w-full max-w-3xl"><slot /></div>
    </div>
  </article>
</BaseLayout>
