---
// 留白畫廊：白底黏性導覽，底線用陰影畫，CTA 黑色。
import { site } from '../../../site.config.mjs';
import { navLinks, ctaHref, ctaAttrs } from '../../lib/nav';
---

<header class="sticky top-0 z-50 bg-white" style="box-shadow: var(--gl-ring);">
  <nav class="t-container flex h-16 items-center justify-between" aria-label="主要導覽">
    <a href="/" class="flex items-center gap-2 text-[15px] font-semibold" style="color: var(--gl-ink); text-decoration: none; letter-spacing: -0.02em;">
      <svg width="18" height="16" viewBox="0 0 18 16" aria-hidden="true"><path d="M9 0l9 16H0z" fill="#171717"/></svg>{site.name}
    </a>
    <div class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-[14px] font-medium" style="color: var(--gl-gray-600); text-decoration: none;">{link.label}</a>
      ))}
      <a href={ctaHref} class="t-btn" style="padding: 6px 14px;" {...ctaAttrs}>{site.cta.label}</a>
    </div>
    <button id="mobile-menu-button" class="flex h-9 w-9 items-center justify-center rounded-full md:hidden" style="box-shadow: var(--gl-ring); color: var(--gl-ink);" aria-label="開啟選單" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden bg-white px-6 pb-5 md:hidden" style="box-shadow: var(--gl-ring);" role="navigation" aria-label="行動版導覽">
    {navLinks.map((link) => (
      <a href={link.href} class="block py-3 text-[15px] font-medium" style="color: var(--gl-gray-600); text-decoration: none;">{link.label}</a>
    ))}
    <a href={ctaHref} class="t-btn mt-3 w-full" {...ctaAttrs}>{site.cta.label}</a>
  </div>
</header>
<script src="../../lib/menu.ts"></script>
