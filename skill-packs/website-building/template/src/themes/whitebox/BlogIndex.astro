---
// 白盒子文章列表：超大標題，文章錯落排列。
interface Post { slug: string; title: string; date: string; description: string; tags?: string[]; coverImage?: string; }
interface Props { posts: Post[]; title?: string; intro?: string; emptyNote?: string; }
const { posts, title, intro, emptyNote } = Astro.props;
const fallbackCovers = ['/images/samples/clean-desk.jpg', '/images/samples/mono-desk.jpg', '/images/samples/phone-edge.jpg', '/images/samples/keyboard-coffee.jpg', '/images/samples/vintage-camera.jpg', '/images/samples/cafe-table.jpg'];
---

<section class="t-container" style="padding-block: 160px 120px;">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <h1 class="t-h1" data-split="chars" data-split-step="30">{title ?? '文章'}</h1>
    <p class="t-lead max-w-sm" data-reveal="up" data-reveal-delay="300">{intro ?? '記錄工作方法、案例與想法。'}</p>
  </div>
  <div class="wb-works mt-20" data-reveal-stagger="140">
    {posts.map((post, index) => (
      <a href={`/blog/${post.slug}/`} class="wb-work">
        <div class="t-media"><img src={post.coverImage ?? fallbackCovers[index % fallbackCovers.length]} alt="" width="1200" height="900" loading="lazy" /></div>
        <h2 class="mt-3 text-[18px] font-medium" style="letter-spacing: -0.015em;">{post.title}</h2>
        <p class="t-muted mt-1 text-[14px] leading-6">{post.description}</p>
        <div class="mt-3 flex flex-wrap items-center gap-2"><time datetime={post.date} class="text-[12px]" style="color: var(--wb-grey);">{post.date}</time>{post.tags && post.tags.map((tag) => <span class="t-tag">{tag}</span>)}</div>
      </a>
    ))}
  </div>
  {posts.length === 0 && <p class="t-note mt-10 max-w-md">{emptyNote ?? '還沒有文章。'}</p>}
</section>
