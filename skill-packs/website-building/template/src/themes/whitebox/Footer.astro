---
import { hasPage } from '../../lib/nav';
// 白盒子：黑底頁尾，左邊超大邀請與白色按鈕，右邊頁面與聯絡。
import { site } from '../../../site.config.mjs';
import { copy } from '../../../site.copy.mjs';
import { footerLinks, ctaHref, ctaAttrs } from '../../lib/nav';
const year = new Date().getFullYear();
---

<footer class="wb-footer" id="footer">
  <div class="t-container grid gap-14 py-20 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
    <div>
      <h2 class="t-h2" style="color: #fff;" data-split="chars" data-split-step="25">{copy.home.closing_heading ?? '開始你的計畫'}</h2>
      <p class="mt-6 max-w-md text-[15px] leading-7" style="color: #b5b5b5;">{copy.home.closing_lead ?? '一封信說明你的情況，我會告訴你值不值得做。'}</p>
      <a href={ctaHref} class="t-btn mt-8" data-magnet="14,14" {...ctaAttrs}><span data-magnet-target>{copy.home.primary_cta ?? site.cta.label}</span></a>
    </div>
    <div class="grid gap-10 sm:grid-cols-2">
      <nav aria-label="頁尾導覽">
        <p class="text-[11px] font-semibold uppercase" style="letter-spacing: 0.1em; color: #7c7c7c;">頁面</p>
        <ul class="mt-4 space-y-2.5 text-[15px] font-medium">{footerLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
      <div>
        <p class="text-[11px] font-semibold uppercase" style="letter-spacing: 0.1em; color: #7c7c7c;">聯絡</p>
        <ul class="mt-4 space-y-2.5 text-[15px] font-medium">{site.contacts.map((channel) => <li><a href={channel.target} {...(channel.kind === 'email' ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>{channel.label} ↗</a></li>)}</ul>
      </div>
    </div>
  </div>
  <div class="t-container flex flex-col gap-2 py-6 text-[12px] uppercase sm:flex-row sm:items-center sm:justify-between" style="border-top: 1px solid rgba(255,255,255,0.15); color: #7c7c7c; letter-spacing: 0.08em;">
    <p>© {year} {site.name}</p>
    <a href="#main-content">Top ↑</a>
  </div>
</footer>
