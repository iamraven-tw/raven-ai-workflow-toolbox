---
// 關於：共用結構，外觀由主題的 .t-* 類別決定。文案由 website-content-writing 補齊。
import BaseLayout from '@theme/BaseLayout.astro';
import { site } from '../../site.config.mjs';
import { ctaHref, ctaAttrs } from '../lib/nav';
---

<BaseLayout title="關於" description={`認識 ${site.name}：${site.positioning}`} canonical="/about">
  <section class="t-container t-section">
    <div class="grid gap-12 lg:grid-cols-[280px_minmax(0,1fr)] lg:items-start">
      <img src="/images/samples/portrait.jpg" alt="" width="900" height="1200" class="t-media w-full max-w-[280px]" style="aspect-ratio: 3 / 4; object-fit: cover;" />
      <div>
        <p class="t-eyebrow">關於</p>
        <h1 class="t-h1 mt-4" style="font-size: clamp(32px, 4vw, 52px);">關於 {site.name}</h1>
        <p class="t-lead mt-6">{site.positioning}</p>
        <div class="t-prose prose prose-lg mt-10 max-w-none">
          <h2>我服務的對象</h2>
          <p>{site.audience}</p>
          <h2>我怎麼工作</h2>
          <p>先釐清目標，再決定做法；每一步都交付可以自己維護的成果。這段文案是佔位，請依實際情況改寫。</p>
        </div>
        <a href={ctaHref} class="t-btn mt-10" {...ctaAttrs}>{site.cta.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
