---
// 關於：共用結構，外觀由主題的 .t-* 類別決定；文字由 site.copy.mjs 提供，null 時用預設。
import BaseLayout from '@theme/BaseLayout.astro';
import { site } from '../../site.config.mjs';
import { copy } from '../../site.copy.mjs';
import { ctaHref, ctaAttrs } from '../lib/nav';
const title = copy.about.title ?? `關於 ${site.name}`;
const intro = copy.about.intro ?? site.positioning;
const sections = copy.about.sections.map((section, index) => ({
  heading: section.heading,
  body: section.body ?? (index === 0 ? site.audience : ''),
})).filter((section) => section.body);
---

<BaseLayout title="關於" description={`認識 ${site.name}：${site.positioning}`} canonical="/about">
  <section class="t-container t-section">
    <div class="grid gap-12 lg:grid-cols-[280px_minmax(0,1fr)] lg:items-start">
      <img src="/images/samples/portrait.jpg" alt="" width="900" height="1200" class="t-media w-full max-w-[280px]" style="aspect-ratio: 3 / 4; object-fit: cover;" />
      <div>
        <p class="t-eyebrow">關於</p>
        <h1 class="t-h1 mt-4" style="font-size: clamp(32px, 4vw, 52px);">{title}</h1>
        <p class="t-lead mt-6">{intro}</p>
        <div class="t-prose prose prose-lg mt-10 max-w-none">
          {sections.map((section) => (
            <>
              <h2>{section.heading}</h2>
              <p>{section.body}</p>
            </>
          ))}
        </div>
        <a href={ctaHref} class="t-btn mt-10" {...ctaAttrs}>{copy.about.cta_heading ?? site.cta.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
