---
// 聯絡：聯絡管道與 website-service-integration 的受管理整合區塊。
import BaseLayout from '@theme/BaseLayout.astro';
import { site } from '../../site.config.mjs';
import { copy } from '../../site.copy.mjs';
import ServiceIntegrations from '../components/ServiceIntegrations.astro';
---

<BaseLayout title="聯絡" description={`聯絡 ${site.name}`} canonical="/contact">
  <section class="t-container t-section">
    <div class="max-w-3xl">
      <p class="t-eyebrow">聯絡</p>
      <h1 class="t-h1 mt-4" style="font-size: clamp(32px, 4vw, 52px);">{copy.contact.title ?? '聯絡我'}</h1>
      <p class="t-lead mt-6">{copy.contact.intro ?? '選一個你方便的方式聯絡我。'}</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {site.contacts.map((channel) => (
          <li>
            <a href={channel.target} class="t-list-item" {...(channel.kind === 'email' ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
              <span>{channel.label}</span><span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <!-- website-service-integration:start -->
      <ServiceIntegrations />
      <!-- website-service-integration:end -->
    </div>
  </section>
</BaseLayout>
