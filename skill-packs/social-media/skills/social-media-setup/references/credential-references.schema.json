{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-workflow-toolbox/credential-references.schema.json",
  "title": "社群媒體本機憑證參照",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace", "backend", "entries", "contains_credentials"],
  "properties": {
    "schema_version": {"const": 2},
    "namespace": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "backend": {"enum": ["macos-keychain", "windows-credential-manager"]},
    "entries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(youtube|instagram|facebook|threads|substack)/[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "name", "source", "status", "updated_at"],
        "properties": {
          "platform": {"enum": ["youtube", "instagram", "facebook", "threads", "substack"]},
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "source": {"enum": ["interactive-terminal", "oauth-callback", "agent-generated", "controlled-browser"]},
          "status": {"enum": ["verified", "pending_write", "pending_delete"]},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "contains_credentials": {"const": false}
  }
}
