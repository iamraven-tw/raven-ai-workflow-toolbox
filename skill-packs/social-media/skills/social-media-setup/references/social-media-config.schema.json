{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-workflow-toolbox/social-media-config.schema.json",
  "title": "社群媒體一般設定",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategy", "integrations"],
  "properties": {
    "schema_version": {"enum": [3, 4, 5]},
    "brand_visual": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "primary_color", "secondary_color", "background_color", "text_color", "font_family", "style_notes", "logo_ref", "main_visual_ref"],
      "properties": {
        "status": {"enum": ["not_configured", "confirmed"]},
        "primary_color": {"$ref": "#/$defs/color"},
        "secondary_color": {"$ref": "#/$defs/color"},
        "background_color": {"$ref": "#/$defs/color"},
        "text_color": {"$ref": "#/$defs/color"},
        "font_family": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "style_notes": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "logo_ref": {"$ref": "#/$defs/assetRef"},
        "main_visual_ref": {"$ref": "#/$defs/assetRef"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "not_configured"}}},
        "then": {"properties": {"primary_color": {"type": "null"}, "secondary_color": {"type": "null"}, "background_color": {"type": "null"}, "text_color": {"type": "null"}, "font_family": {"type": "null"}, "style_notes": {"type": "null"}, "logo_ref": {"type": "null"}, "main_visual_ref": {"type": "null"}}},
        "else": {"anyOf": [{"properties": {"primary_color": {"type": "string"}}}, {"properties": {"secondary_color": {"type": "string"}}}, {"properties": {"background_color": {"type": "string"}}}, {"properties": {"text_color": {"type": "string"}}}, {"properties": {"font_family": {"type": "string"}}}, {"properties": {"style_notes": {"type": "string"}}}, {"properties": {"logo_ref": {"type": "string"}}}, {"properties": {"main_visual_ref": {"type": "string"}}}]}
      }]
    },
    "image_production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_method", "information_dense_method", "web_provider", "icon_source"],
      "properties": {
        "default_method": {"enum": ["not_configured", "codex", "antigravity", "web", "html_css"]},
        "information_dense_method": {"enum": ["inherit", "html_css"]},
        "web_provider": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "icon_source": {"enum": ["heroicons", "none"]}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "primary_goal", "audience_summary", "content_pillars", "platform_roles", "strategy_source"],
      "properties": {
        "status": {"enum": ["not_configured", "partial", "configured"]},
        "primary_goal": {"type": ["string", "null"], "maxLength": 500},
        "audience_summary": {"type": ["string", "null"], "maxLength": 1000},
        "content_pillars": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}, "uniqueItems": true},
        "platform_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["youtube", "instagram", "facebook", "threads", "substack"],
          "properties": {
            "youtube": {"type": ["string", "null"], "maxLength": 500},
            "instagram": {"type": ["string", "null"], "maxLength": 500},
            "facebook": {"type": ["string", "null"], "maxLength": 500},
            "threads": {"type": ["string", "null"], "maxLength": 500},
            "substack": {"type": ["string", "null"], "maxLength": 500}
          }
        },
        "strategy_source": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.md$", "maxLength": 300}
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["youtube", "instagram", "facebook", "threads", "substack"],
      "properties": {
        "youtube": {"$ref": "#/$defs/integration"},
        "instagram": {"$ref": "#/$defs/integration"},
        "facebook": {"$ref": "#/$defs/integration"},
        "threads": {"$ref": "#/$defs/integration"},
        "substack": {"$ref": "#/$defs/integration"}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"enum": [4, 5]}}},
    "then": {"required": ["image_production"]},
    "else": {"not": {"required": ["image_production"]}}
  }, {
    "if": {"properties": {"schema_version": {"const": 5}}},
    "then": {"required": ["brand_visual"]},
    "else": {"not": {"required": ["brand_visual"]}}
  }],
  "$defs": {
    "color": {"type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$"},
    "assetRef": {"type": ["string", "null"], "minLength": 1, "maxLength": 300, "pattern": "^(?![/~])(?!.*[:\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.$).+$"},
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "requested_capabilities", "authorization_profile", "requested_permissions", "declined_permissions", "preferred_interface", "status", "verification", "last_verified_at"],
      "properties": {
        "selected": {"type": "boolean"},
        "requested_capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["account_read", "publish", "public_comments", "analytics", "direct_messages"]}},
        "authorization_profile": {"enum": ["not_selected", "full_management", "custom"]},
        "requested_permissions": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^\\S(?:.*\\S)?$"}},
        "declined_permissions": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^\\S(?:.*\\S)?$"}},
        "preferred_interface": {"enum": ["not_selected", "official_api", "official_connector", "reliable_cli", "controlled_browser", "computer_use", "manual"]},
        "status": {"enum": ["not_configured", "planned", "requires_user_action", "locally_prepared", "partially_verified", "verified"]},
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api_app", "user_auth", "platform_read", "remote_write"],
          "properties": {
            "api_app": {"enum": ["not_applicable", "not_started", "planned", "requires_user_action", "configured", "verified", "failed", "unknown"]},
            "user_auth": {"enum": ["not_applicable", "not_started", "planned", "requires_user_action", "verified", "failed", "unknown"]},
            "platform_read": {"enum": ["not_started", "planned", "requires_user_action", "verified", "empty", "permission_denied", "failed", "unknown"]},
            "remote_write": {"enum": ["not_requested", "not_authorized", "not_tested", "requires_user_action", "verified", "failed", "unknown"]}
          }
        },
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
