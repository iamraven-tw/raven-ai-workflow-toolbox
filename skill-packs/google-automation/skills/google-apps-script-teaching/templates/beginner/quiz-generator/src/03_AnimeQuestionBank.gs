/**
 * 建立日本動漫教學題庫。
 *
 * 題庫選用經典角色與作品基本設定，避免近期劇情與重大暴雷。
 * 每部作品各有 5 題是非題及 5 題單選題，合計 100 題。
 *
 * @return {Array<Array<*>>} 可直接寫入 Sheets 的題庫資料。
 */
function buildQuizQuestionFixtures_() {
  var definitions = buildAnimeQuizQuestionDefinitions_();

  return definitions.map(function (question, index) {
    return [
      true,
      'Q' + String(index + 1).padStart(3, '0'),
      '【' + question.franchise + '】' + question.title,
      question.type,
      question.options.join('|'),
      question.answer,
      5,
      question.explanation,
      '正確答案是「' + question.answer + '」。' + question.explanation
    ];
  });
}

/**
 * 建立一題是非題。
 *
 * @param {string} franchise 作品名稱。
 * @param {string} title 題目。
 * @param {string} answer 正確答案，只能是「是」或「否」。
 * @param {string} explanation 答案說明。
 * @return {Object} 題目定義。
 */
function animeTrueFalse_(franchise, title, answer, explanation) {
  return {
    franchise: franchise,
    title: title,
    type: '是非題',
    options: ['是', '否'],
    answer: answer,
    explanation: explanation
  };
}

/**
 * 建立一題四選一單選題。
 *
 * @param {string} franchise 作品名稱。
 * @param {string} title 題目。
 * @param {Array<string>} options 四個選項。
 * @param {string} answer 正確答案。
 * @param {string} explanation 答案說明。
 * @return {Object} 題目定義。
 */
function animeChoice_(franchise, title, options, answer, explanation) {
  return {
    franchise: franchise,
    title: title,
    type: '單選題',
    options: options,
    answer: answer,
    explanation: explanation
  };
}

